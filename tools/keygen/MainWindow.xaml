<Window x:Class="TequilasTavern.Keygen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tequilas' Tavern — License Keygen"
        Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="{StaticResource Bg}">
    <Border BorderBrush="#FFFFFF" BorderThickness="3" Padding="2" Margin="10">
    <Border BorderBrush="#8090E8" BorderThickness="1">
        <StackPanel Margin="20,18">
            <TextBlock Text="LICENSE KEYGEN" Foreground="{StaticResource Gold}"
                       FontFamily="Lucida Console, Consolas" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Mint a license key for a customer, then paste it into their download delivery."
                       Foreground="{StaticResource Dim}" FontSize="12" Margin="0,4,0,14" TextWrapping="Wrap"/>

            <!-- Signing key status -->
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="4" Padding="10,8" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Signing key:" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="KeyStatus" Text="none loaded" Foreground="{StaticResource Text}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                    <Button Content="Load key…" Click="LoadKey_Click" Margin="12,0,0,0" Padding="8,4"/>
                    <Button Content="New keypair…" Click="NewKeypair_Click" Margin="6,0,0,0" Padding="8,4"
                            Background="Transparent" BorderBrush="{StaticResource Border}"/>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Label Content="Buyer name"/>
                    <TextBox x:Name="NameBox"/>
                    <Label Content="Order # (from Etsy)" Margin="0,10,0,0"/>
                    <TextBox x:Name="OrderBox"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Label Content="Buyer email"/>
                    <TextBox x:Name="EmailBox"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Label Content="Devices"/>
                            <TextBox x:Name="MaxBox" Text="2"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="Expires (days, 0 = never)"/>
                            <TextBox x:Name="DaysBox" Text="0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button x:Name="GenBtn" Content="Generate license key" Click="Generate_Click"
                        Padding="14,8" FontWeight="Bold"/>
                <Button x:Name="FriendBtn" Content="🎁 Friend / gift key" Click="FriendKey_Click"
                        Padding="12,8" Margin="10,0,0,0"
                        Background="Transparent" BorderBrush="{StaticResource Gold}" Foreground="{StaticResource Gold}"
                        ToolTip="One click — makes a perpetual key with no details required."/>
            </StackPanel>

            <Label Content="License key" Margin="0,14,0,0"/>
            <TextBox x:Name="OutBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="72"
                     FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="CopyBtn" Content="Copy" Click="Copy_Click" IsEnabled="False"/>
                <Button x:Name="SaveBtn" Content="Save .lic…" Click="Save_Click" IsEnabled="False" Margin="8,0,0,0"/>
            </StackPanel>

            <TextBlock x:Name="Status" Text="" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,12,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
    </Border>
</Window>
