<Window x:Class="GameTracker.Views.VoiceMorphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Voice Morph"
        Width="600" Height="640"
        MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize"
        Icon="/iguana-eye.ico"
        Background="{DynamicResource ScaleBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#a8c488"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="86"/>
        </Style>
        <Style x:Key="In" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
            <Setter Property="Foreground" Value="#e8e0c4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface2}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource ThemeAccentDeep}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeAccentDeep}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource ThemeAccentDeep}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource ThemeBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Image Source="/iguana-eye.ico" Width="16" Height="16" Margin="0,0,8,0"
                               VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="VOICE MORPH" Foreground="{DynamicResource ThemeAccent}" FontSize="11"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="&#x2715;" Click="Close_Click"
                            Style="{StaticResource WindowCloseButton}" Height="32"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <!-- Engine config -->
            <StackPanel Grid.Row="1" Margin="16,12,16,6">
                <CheckBox x:Name="EnabledCb" Content="Enable mic morph (your mic runs through the app; normal voice when no morph is active)"
                          Foreground="#e8e0c4" FontSize="12" Margin="0,0,0,8"
                          Checked="Enabled_Changed" Unchecked="Enabled_Changed"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Microphone" Style="{StaticResource Lbl}"/>
                    <ComboBox x:Name="InputBox" Width="200" Margin="0,0,10,0" SelectionChanged="Device_Changed"/>
                    <TextBlock Text="Output" Style="{StaticResource Lbl}" Width="50"/>
                    <ComboBox x:Name="OutputBox" Width="200" SelectionChanged="Device_Changed"/>
                </StackPanel>
                <TextBlock Foreground="#7a9070" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="To get this into your stream: in OBS add an 'Application Audio Capture' source pointed at Game Tracker, and mute your raw Mic source. (Or set Output to a virtual cable like VB-CABLE and use that as your OBS mic — silent for you automatically.) Pick your headphones as Output to preview privately, or 🔇 None to hear nothing (note: with None there's no audio for OBS App Capture either — use a cable or an unheard device for streaming)."/>
                <TextBlock x:Name="EngineStatus" Foreground="{DynamicResource ThemeAccent2}" FontSize="11" Margin="0,0,0,4"/>

                <Border Background="{DynamicResource ThemeBorder}" Height="1" Margin="0,4,0,10"/>

                <!-- Builder -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Name" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="NameBox" Width="150" Style="{StaticResource In}" Margin="0,0,10,0"/>
                    <TextBlock Text="Effect" Style="{StaticResource Lbl}" Width="44"/>
                    <ComboBox x:Name="EffectBox" Width="120"/>
                    <TextBlock Text="Timer (s)" Style="{StaticResource Lbl}" Width="58" Margin="10,0,4,0"/>
                    <TextBox x:Name="TimerBox" Width="48" Style="{StaticResource In}" Text="60"
                             ToolTip="How long a redeem keeps this voice on before auto-reverting"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Pitch" Style="{StaticResource Lbl}"/>
                    <Slider x:Name="PitchSlider" Width="240" Minimum="-12" Maximum="12" Value="0"
                            IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                            Foreground="{DynamicResource ThemeAccent}" ValueChanged="Pitch_Changed"/>
                    <TextBlock x:Name="PitchVal" Text="0 st" Foreground="#e8e0c4" FontSize="12"
                               VerticalAlignment="Center" Margin="8,0,0,0" Width="44"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="TryBtn" Content="&#127897; Try it live" Click="Try_Click" Style="{StaticResource Btn}" Margin="0,0,8,0"
                            ToolTip="Hear this morph on your mic right now (30s, or Revert)"/>
                    <Button Content="&#8634; Revert to normal" Click="Revert_Click" Style="{StaticResource Btn}" Margin="0,0,8,0"/>
                    <Button Content="&#128190; Save voice" Click="Save_Click" Style="{StaticResource Btn}"/>
                </StackPanel>
                <TextBlock x:Name="Status" Foreground="{DynamicResource ThemeAccent}" FontSize="11" Height="14" Margin="86,4,0,0"/>
            </StackPanel>

            <!-- Saved morphs -->
            <Border Grid.Row="2" Margin="16,4,16,14" Background="{DynamicResource ThemeSurface}"
                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="YOUR SAVED MORPHS (use in redeems as ! commands)"
                               Foreground="{DynamicResource ThemeAccent}" FontSize="11" FontWeight="Bold" Margin="10,8,10,4"/>
                    <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Foreground="#506050" FontSize="11"
                               Margin="10,0,10,0" Text="None yet — build one above and Save."/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,4,10,10">
                        <ItemsControl x:Name="PresetList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ThemeSurface2}" BorderBrush="{DynamicResource ThemeBorder}"
                                            BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="#e8e0c4" FontSize="13" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Detail}" Foreground="#7a9070" FontSize="11"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="&#9654; Activate" Tag="{Binding}" Click="Activate_Click"
                                                    Style="{StaticResource Btn}" Margin="0,0,6,0"
                                                    ToolTip="Turn this morph on now (auto-reverts after its timer)"/>
                                            <Button Grid.Column="2" Content="&#x2715;" Tag="{Binding}" Click="Delete_Click"
                                                    Style="{StaticResource Btn}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
