<Window x:Class="GameTracker.Views.VoiceMorphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Voice Morph"
        Width="600" Height="820"
        MinWidth="520" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize"
        Icon="/tt-chat.ico"
        Background="{DynamicResource ScaleBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8494d8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="86"/>
        </Style>
        <Style x:Key="In" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface2}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource ThemeAccentDeep}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeAccentDeep}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource ThemeAccentDeep}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource ThemeBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Image Source="/tt-chat.ico" Width="16" Height="16" Margin="0,0,8,0"
                               VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="VOICE MORPH" Foreground="{DynamicResource ThemeAccent}" FontSize="11"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="&#x2715;" Click="Close_Click"
                            Style="{StaticResource WindowCloseButton}" Height="32"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <!-- Everything scrolls together so nothing is ever cut off at any window size -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12,16,14">
              <StackPanel>
                <CheckBox x:Name="EnabledCb" Margin="0,0,0,8" VerticalContentAlignment="Center"
                          Checked="Enabled_Changed" Unchecked="Enabled_Changed">
                    <TextBlock Foreground="#ffffff" FontSize="12" TextWrapping="Wrap" MaxWidth="520"
                               Text="Use the app as my audio source (always on) — runs your mic through the app so OBS can capture it. Your normal voice by default; morphs apply when triggered. Stays live and auto-recovers while the app is open."/>
                </CheckBox>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Microphone" Style="{StaticResource Lbl}"/>
                    <ComboBox x:Name="InputBox" Width="200" Margin="0,0,10,0" SelectionChanged="Device_Changed"/>
                    <TextBlock Text="Output" Style="{StaticResource Lbl}" Width="50"/>
                    <ComboBox x:Name="OutputBox" Width="200" SelectionChanged="Device_Changed"/>
                </StackPanel>
                <Button Content="&#10067; OBS setup guide (with screenshots)" Click="Help_Click"
                        Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0,0,0,8"
                        ToolTip="Open the step-by-step OBS setup guide"/>
                <TextBlock Foreground="#6f7cb5" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="To get this into your stream: in OBS add an 'Application Audio Capture (BETA)' source (NOT 'Audio Input Capture') with its Window set to Game Tracker, then mute your raw Mic source. Output here is only what YOU hear back — OBS captures the app no matter which device you pick. See Settings → How to → 'Voice Morph → OBS' for the full walkthrough."/>
                <TextBlock x:Name="OutputWarn" Foreground="#f8d878" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="Collapsed"
                           Text="⚠ Output is set to 🔇 None, so nothing plays and there's no audio for OBS to capture. Pick a real device (🎧 System default is fine) if you want the morph on stream."/>
                <TextBlock x:Name="EngineStatus" Foreground="{DynamicResource ThemeAccent2}" FontSize="11" Margin="0,0,0,4"/>

                <Border Background="{DynamicResource ThemeBorder}" Height="1" Margin="0,4,0,10"/>

                <!-- Builder -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Name" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="NameBox" Width="180" Style="{StaticResource In}" Margin="0,0,10,0"/>
                    <TextBlock Text="Timer (s)" Style="{StaticResource Lbl}" Width="58" Margin="10,0,4,0"/>
                    <TextBox x:Name="TimerBox" Width="48" Style="{StaticResource In}" Text="60"
                             ToolTip="How long a redeem keeps this voice on before auto-reverting"/>
                </StackPanel>

                <TextBlock Text="VOICE MIXER — push a bar right to add an effect. Pitch and Tone also go LEFT for the opposite (deeper / warmer)."
                           Foreground="{DynamicResource ThemeAccent}" FontSize="11" FontWeight="Bold"
                           TextWrapping="Wrap" Margin="0,0,0,6"/>

                <!-- Pitch bar (bidirectional: left = deeper, right = higher) -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Pitch" Foreground="#8494d8" FontSize="12" VerticalAlignment="Center" Width="120"/>
                    <Slider x:Name="PitchSlider" Width="330" Minimum="-12" Maximum="12" Value="0"
                            IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                            Foreground="{DynamicResource ThemeAccent}" ValueChanged="Pitch_Changed"/>
                    <TextBlock x:Name="PitchVal" Text="0 st" Foreground="#ffffff" FontSize="12"
                               VerticalAlignment="Center" Margin="8,0,0,0" Width="44"/>
                </StackPanel>

                <!-- Effect bars are built in code from VoiceMorphService.MixBars -->
                <StackPanel x:Name="MixHost" Margin="0,0,0,4"/>

                <WrapPanel Margin="0,2,0,0">
                    <Button x:Name="TryBtn" Content="&#127897; Try it live" Click="Try_Click" Style="{StaticResource Btn}" Margin="0,0,8,6"
                            ToolTip="Hear this on your MIC right now (30s, or Revert)"/>
                    <Button Content="&#128266; Test with TTS" Click="TtsTest_Click" Style="{StaticResource Btn}" Margin="0,0,8,6"
                            ToolTip="Play a spoken test line through the current bars — no mic needed"/>
                    <Button Content="&#8634; Revert to normal" Click="Revert_Click" Style="{StaticResource Btn}" Margin="0,0,8,6"/>
                    <Button Content="&#128190; Save voice" Click="Save_Click" Style="{StaticResource Btn}" Margin="0,0,0,6"
                            ToolTip="Save the current bars as a voice (type its name above). Same name overwrites it."/>
                </WrapPanel>
                <TextBlock x:Name="Status" Foreground="{DynamicResource ThemeAccent}" FontSize="11" MinHeight="14" Margin="0,2,0,0" TextWrapping="Wrap"/>

                <Border Background="{DynamicResource ThemeBorder}" Height="1" Margin="0,10,0,10"/>

                <!-- Your voices — the single list (starters + anything you build). -->
                <TextBlock Text="YOUR VOICES" Foreground="{DynamicResource ThemeAccent}" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
                <TextBlock Foreground="#6f7cb5" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Load a voice to edit its bars, Activate it now, or delete it. Every voice here can be attached to a point redeem in the 🪙 Points &amp; Redeems section."/>
                <TextBlock x:Name="EmptyText" Foreground="#4a5798" FontSize="11" Margin="0,0,0,4"
                           Text="None yet — build one above and Save."/>
                <ItemsControl x:Name="PresetList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource ThemeSurface2}" BorderBrush="{DynamicResource ThemeBorder}"
                                    BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="#ffffff" FontSize="13" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Detail}" Foreground="#6f7cb5" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="&#9998; Load" Tag="{Binding}" Click="Load_Click"
                                            Style="{StaticResource Btn}" Margin="0,0,6,0"
                                            ToolTip="Load this voice into the bars above to edit it (Save to overwrite)"/>
                                    <Button Grid.Column="2" Content="&#9654; Activate" Tag="{Binding}" Click="Activate_Click"
                                            Style="{StaticResource Btn}" Margin="0,0,6,0"
                                            ToolTip="Turn this voice on now (auto-reverts after its timer)"/>
                                    <Button Grid.Column="3" Content="&#x2715;" Tag="{Binding}" Click="Delete_Click"
                                            Style="{StaticResource Btn}" ToolTip="Delete this voice"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
