<Window x:Class="GameTracker.Views.TextPanelsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Text Overlays"
        Width="720" Height="640"
        MinWidth="600" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize"
        Icon="/iguana-eye.ico"
        Background="{DynamicResource ScaleBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface2}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}" BorderBrush="{DynamicResource ThemeAccentDeep}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeAccentDeep}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="In" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
            <Setter Property="Foreground" Value="#e8e0c4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#7cc44a"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Lb" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7a9070"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource ThemeAccentDeep}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource ThemeBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Image Source="/iguana-eye.ico" Width="16" Height="16" Margin="0,0,8,0"
                               VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="TEXT OVERLAYS" Foreground="{DynamicResource ThemeAccent}" FontSize="11"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="&#x2715;" Click="Close_Click"
                            Style="{StaticResource WindowCloseButton}" Height="32"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <!-- Header row -->
            <Grid Grid.Row="1" Margin="14,10,14,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Foreground="#a8c488" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="Custom OBS text panels (up to 5). Changes save and update OBS live as you type. Add each panel's URL as a Browser source."/>
                <Button Grid.Column="1" x:Name="AddPanelBtn" Content="+ Add overlay" Click="AddPanel_Click"
                        Style="{StaticResource Btn}" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="14,0,14,12">
                <ItemsControl x:Name="PanelList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                                    CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <!-- Panel title row: URL + copy + remove -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="{DynamicResource ThemeAccent2}"
                                                   FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Url}" Foreground="#7a9070"
                                                   FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="2" Content="Copy URL" Tag="{Binding}" Click="CopyUrl_Click"
                                                Style="{StaticResource Btn}" Margin="0,0,6,0"/>
                                        <Button Grid.Column="3" Content="&#x2715;" Tag="{Binding}" Click="RemovePanel_Click"
                                                Style="{StaticResource Btn}" ToolTip="Remove this overlay"/>
                                    </Grid>

                                    <!-- Header editor -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Header" Style="{StaticResource Lb}"/>
                                        <TextBox Grid.Column="1" Text="{Binding HeaderText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource In}" Margin="0,0,6,0"/>
                                        <ComboBox Grid.Column="2" Width="120" Margin="0,0,6,0"
                                                  ItemsSource="{Binding Fonts}" SelectedItem="{Binding HeaderFont}"/>
                                        <TextBox Grid.Column="3" Width="42" Text="{Binding HeaderSize, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource In}" Margin="0,0,6,0" ToolTip="Font size (px)"/>
                                        <Button Grid.Column="4" Tag="{Binding}" Click="PickHeaderColor_Click"
                                                Cursor="Hand" Margin="0,0,4,0" ToolTip="Pick a color">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Width="18" Height="18" CornerRadius="3"
                                                            Background="{Binding HeaderBrush}"
                                                            BorderBrush="{DynamicResource ThemeAccentDeep}" BorderThickness="1"/>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBox Grid.Column="5" Width="66" Text="{Binding HeaderColor, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource In}" ToolTip="Hex color, e.g. #7cc44a"/>
                                    </Grid>

                                    <!-- Background opacity -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Background" Style="{StaticResource Lb}"/>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" SmallChange="5"
                                                Value="{Binding Opacity}" VerticalAlignment="Center"
                                                Foreground="{DynamicResource ThemeAccent}" ToolTip="Background opacity (100 = solid)"/>
                                        <TextBlock Grid.Column="2" Text="{Binding OpacityLabel}" Foreground="#a8c488"
                                                   FontSize="11" VerticalAlignment="Center" Width="38"
                                                   TextAlignment="Right"/>
                                    </Grid>

                                    <!-- Side blocks (bordered boxes left/right of the panel; empty = hidden) -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Left" Style="{StaticResource Lb}" Width="38"/>
                                        <TextBox Grid.Column="1" Text="{Binding LeftText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource In}" Margin="0,0,6,0" AcceptsReturn="True"
                                                 TextWrapping="Wrap" MinHeight="40" VerticalScrollBarVisibility="Auto"
                                                 ToolTip="Left side block (leave empty to hide). Enter for new lines."/>
                                        <ComboBox Grid.Column="2" Width="110" Margin="0,0,6,0" VerticalAlignment="Top"
                                                  ItemsSource="{Binding Fonts}" SelectedItem="{Binding LeftFont}"/>
                                        <TextBox Grid.Column="3" Width="40" Text="{Binding LeftSize, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource In}" Margin="0,0,6,0" VerticalAlignment="Top"
                                                 ToolTip="Font size (px)"/>
                                        <Button Grid.Column="4" Tag="{Binding}" Click="PickLeftColor_Click"
                                                Cursor="Hand" Margin="0,4,4,0" VerticalAlignment="Top" ToolTip="Pick a color">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Width="18" Height="18" CornerRadius="3"
                                                            Background="{Binding LeftBrush}"
                                                            BorderBrush="{DynamicResource ThemeAccentDeep}" BorderThickness="1"/>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBox Grid.Column="5" Width="62" Text="{Binding LeftColor, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource In}" VerticalAlignment="Top" ToolTip="Hex color"/>
                                    </Grid>
                                    <Grid Margin="44,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="&#128444; Image" Tag="{Binding}" Click="PickLeftImage_Click"
                                                Style="{StaticResource Btn}" Margin="0,0,6,0"
                                                ToolTip="Optional image shown in the left block"/>
                                        <TextBlock Grid.Column="1" Text="{Binding LeftImageName}" Foreground="#7a9070"
                                                   FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding LeftImage}"/>
                                        <TextBlock Grid.Column="2" Text="width" Style="{StaticResource Lb}" Margin="8,0,4,0"/>
                                        <TextBox Grid.Column="3" Width="48" Text="{Binding LeftImageWidth, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource In}" Margin="0,0,6,0" ToolTip="Image width in pixels (height keeps aspect)"/>
                                        <Button Grid.Column="4" Content="&#x2715;" Tag="{Binding}" Click="ClearLeftImage_Click"
                                                Style="{StaticResource Btn}" ToolTip="Remove image"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="44,0,0,8">
                                        <TextBlock Text="Direction" Style="{StaticResource Lb}"/>
                                        <ComboBox Width="104" Margin="0,0,10,0" SelectedValue="{Binding LeftDir}"
                                                  SelectedValuePath="Tag" VerticalAlignment="Center">
                                            <ComboBoxItem Tag="v" Content="Vertical"/>
                                            <ComboBoxItem Tag="h" Content="Horizontal"/>
                                        </ComboBox>
                                        <CheckBox Content="scroll" IsChecked="{Binding LeftScroll}" Foreground="#a8c488"
                                                  FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"
                                                  ToolTip="Scroll the block (up if Vertical, sideways if Horizontal)"/>
                                        <Slider Width="90" Minimum="20" Maximum="300" Value="{Binding LeftSpeed}"
                                                VerticalAlignment="Center" Foreground="{DynamicResource ThemeAccent}"
                                                IsEnabled="{Binding LeftScroll}" ToolTip="Scroll speed (pixels per second)"/>
                                    </StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Right" Style="{StaticResource Lb}" Width="38"/>
                                        <TextBox Grid.Column="1" Text="{Binding RightText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource In}" Margin="0,0,6,0" AcceptsReturn="True"
                                                 TextWrapping="Wrap" MinHeight="40" VerticalScrollBarVisibility="Auto"
                                                 ToolTip="Right side block (leave empty to hide). Enter for new lines."/>
                                        <ComboBox Grid.Column="2" Width="110" Margin="0,0,6,0" VerticalAlignment="Top"
                                                  ItemsSource="{Binding Fonts}" SelectedItem="{Binding RightFont}"/>
                                        <TextBox Grid.Column="3" Width="40" Text="{Binding RightSize, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource In}" Margin="0,0,6,0" VerticalAlignment="Top"
                                                 ToolTip="Font size (px)"/>
                                        <Button Grid.Column="4" Tag="{Binding}" Click="PickRightColor_Click"
                                                Cursor="Hand" Margin="0,4,4,0" VerticalAlignment="Top" ToolTip="Pick a color">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Width="18" Height="18" CornerRadius="3"
                                                            Background="{Binding RightBrush}"
                                                            BorderBrush="{DynamicResource ThemeAccentDeep}" BorderThickness="1"/>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBox Grid.Column="5" Width="62" Text="{Binding RightColor, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource In}" VerticalAlignment="Top" ToolTip="Hex color"/>
                                    </Grid>
                                    <Grid Margin="44,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="&#128444; Image" Tag="{Binding}" Click="PickRightImage_Click"
                                                Style="{StaticResource Btn}" Margin="0,0,6,0"
                                                ToolTip="Optional image shown in the right block"/>
                                        <TextBlock Grid.Column="1" Text="{Binding RightImageName}" Foreground="#7a9070"
                                                   FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding RightImage}"/>
                                        <TextBlock Grid.Column="2" Text="width" Style="{StaticResource Lb}" Margin="8,0,4,0"/>
                                        <TextBox Grid.Column="3" Width="48" Text="{Binding RightImageWidth, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource In}" Margin="0,0,6,0" ToolTip="Image width in pixels (height keeps aspect)"/>
                                        <Button Grid.Column="4" Content="&#x2715;" Tag="{Binding}" Click="ClearRightImage_Click"
                                                Style="{StaticResource Btn}" ToolTip="Remove image"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="44,0,0,8">
                                        <TextBlock Text="Direction" Style="{StaticResource Lb}"/>
                                        <ComboBox Width="104" Margin="0,0,10,0" SelectedValue="{Binding RightDir}"
                                                  SelectedValuePath="Tag" VerticalAlignment="Center">
                                            <ComboBoxItem Tag="v" Content="Vertical"/>
                                            <ComboBoxItem Tag="h" Content="Horizontal"/>
                                        </ComboBox>
                                        <CheckBox Content="scroll" IsChecked="{Binding RightScroll}" Foreground="#a8c488"
                                                  FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"
                                                  ToolTip="Scroll the block (up if Vertical, sideways if Horizontal)"/>
                                        <Slider Width="90" Minimum="20" Maximum="300" Value="{Binding RightSpeed}"
                                                VerticalAlignment="Center" Foreground="{DynamicResource ThemeAccent}"
                                                IsEnabled="{Binding RightScroll}" ToolTip="Scroll speed (pixels per second)"/>
                                    </StackPanel>

                                    <Border Background="{DynamicResource ThemeBorder}" Height="1" Margin="0,2,0,8"/>

                                    <!-- Lines -->
                                    <ItemsControl ItemsSource="{Binding Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource In}" Margin="0,0,6,0"/>
                                                    <ComboBox Grid.Column="1" Width="110" Margin="0,0,6,0"
                                                              ItemsSource="{Binding Fonts}" SelectedItem="{Binding Font}"/>
                                                    <TextBox Grid.Column="2" Width="40" Text="{Binding Size, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource In}" Margin="0,0,6,0" ToolTip="Font size (px)"/>
                                                    <Button Grid.Column="3" Tag="{Binding}" Click="PickLineColor_Click"
                                                            Cursor="Hand" Margin="0,0,4,0" ToolTip="Pick a color">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Width="18" Height="18" CornerRadius="3"
                                                                        Background="{Binding ColorBrush}"
                                                                        BorderBrush="{DynamicResource ThemeAccentDeep}" BorderThickness="1"/>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <TextBox Grid.Column="4" Width="62" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource In}" Margin="0,0,8,0" ToolTip="Hex color"/>
                                                    <CheckBox Grid.Column="5" Content="scroll" IsChecked="{Binding Scroll}"
                                                              Foreground="#a8c488" FontSize="11" VerticalAlignment="Center"
                                                              Margin="0,0,4,0" ToolTip="Marquee-scroll this line"/>
                                                    <Slider Grid.Column="6" Width="70" Minimum="20" Maximum="300"
                                                            Value="{Binding Speed}" VerticalAlignment="Center"
                                                            Foreground="{DynamicResource ThemeAccent}" Margin="0,0,6,0"
                                                            IsEnabled="{Binding Scroll}" ToolTip="Scroll speed (pixels per second)"/>
                                                    <Button Grid.Column="7" Content="&#x2715;" Tag="{Binding}" Click="RemoveLine_Click"
                                                            Style="{StaticResource Btn}" ToolTip="Remove line"/>
                                                </Grid>
                                                <Grid Margin="0,3,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Content="&#128444; Image" Tag="{Binding}" Click="PickLineImage_Click"
                                                            Style="{StaticResource Btn}" Margin="0,0,6,0"
                                                            ToolTip="Optional image shown before this line"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ImageName}" Foreground="#7a9070"
                                                               FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Image}"/>
                                                    <TextBlock Grid.Column="2" Text="width" Style="{StaticResource Lb}" Margin="8,0,4,0"/>
                                                    <TextBox Grid.Column="3" Width="48" Text="{Binding ImageWidth, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource In}" Margin="0,0,6,0" ToolTip="Image width in pixels (height keeps aspect)"/>
                                                    <Button Grid.Column="4" Content="&#x2715;" Tag="{Binding}" Click="ClearLineImage_Click"
                                                            Style="{StaticResource Btn}" ToolTip="Remove image"/>
                                                </Grid>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="+ Add line" Tag="{Binding}" Click="AddLine_Click"
                                            Style="{StaticResource Btn}" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
