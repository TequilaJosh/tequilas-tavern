<Window x:Class="GameTracker.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:GameTracker.Views"
        Title="Chat"
        Width="460" Height="680"
        MinWidth="380" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True"
        Icon="/iguana-eye.ico"
        Background="{DynamicResource ScaleBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ConnectBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface2}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource ThemeAccentDeep}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeAccentDeep}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChanBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
            <Setter Property="Foreground" Value="#e8e0c4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#7cc44a"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource ThemeAccentDeep}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource ThemeBg}"
                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Image Source="/iguana-eye.ico" Width="16" Height="16" Margin="0,0,8,0"
                               VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="LIVE CHAT" Foreground="{DynamicResource ThemeAccent}" FontSize="11"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MuteButton" Content="&#128266;" Click="Mute_Click"
                                Style="{StaticResource WindowControlButton}" FontSize="11"
                                ToolTip="Stop sound alerts (panic): kill the current alert and mute incoming"/>
                        <Button x:Name="CollapseButton" Content="&#9650;" Click="Collapse_Click"
                                Style="{StaticResource WindowControlButton}" FontSize="9"
                                ToolTip="Hide the connect bar (clean chat box)"/>
                        <Button x:Name="PinButton" Content="&#128204;" Click="Pin_Click"
                                Style="{StaticResource WindowControlButton}" ToolTip="Pin on top"/>
                        <Button Content="&#x2715;" Click="Close_Click"
                                Style="{StaticResource WindowCloseButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Connect panel -->
            <Border x:Name="ConnectPanel" Grid.Row="1" Background="{DynamicResource ThemeSurface}" Padding="10"
                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <!-- Twitch (direct, no login) -->
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" Background="#9146FF" CornerRadius="3"
                                Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="TW" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                        <TextBox x:Name="TwitchBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource ChanBox}"
                                 Margin="0,0,6,0" ToolTip="Twitch channel name (no login needed)"/>
                        <Button x:Name="TwitchBtn" Grid.Row="0" Grid.Column="2" Content="Connect"
                                Style="{StaticResource ConnectBtn}" Click="Twitch_Click"/>
                        <TextBlock x:Name="TwitchStatus" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                   Text="Twitch — channel name, no login" Foreground="#7a9070" FontSize="11"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <!-- Social Stream Ninja (aggregator: all platforms) -->
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource ThemeAccentDeep}" CornerRadius="3"
                                Padding="5,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="SSN" Foreground="{DynamicResource ThemeBg}" FontSize="11" FontWeight="Bold"/>
                        </Border>
                        <TextBox x:Name="SsnBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource ChanBox}"
                                 Margin="0,0,6,0" ToolTip="Social Stream Ninja session ID (from your dock URL)"/>
                        <Button x:Name="SsnBtn" Grid.Row="0" Grid.Column="2" Content="Connect"
                                Style="{StaticResource ConnectBtn}" Click="Ssn_Click"/>
                        <TextBlock x:Name="SsnStatus" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                   Text="Social Stream Ninja — session ID brings in all platforms"
                                   Foreground="#7a9070" FontSize="11" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <TextBlock Margin="42,-3,0,9" FontSize="11" TextWrapping="Wrap">
                        <Hyperlink Foreground="{DynamicResource ThemeAccent}" TextDecorations="Underline" Click="SsnGuide_Click">
                            SSN not showing chat? Setup guide
                        </Hyperlink>
                    </TextBlock>

                    <!-- Restream -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" Background="#1f6feb" CornerRadius="3"
                                Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="RS" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                        <TextBox x:Name="RestreamBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource ChanBox}"
                                 Margin="0,0,6,0" ToolTip="Restream OAuth access token"/>
                        <Button x:Name="RestreamBtn" Grid.Row="0" Grid.Column="2" Content="Connect"
                                Style="{StaticResource ConnectBtn}" Click="Restream_Click"/>
                        <TextBlock x:Name="RestreamStatus" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                   Text="Restream — paste an access token (needs a Restream app)"
                                   Foreground="#7a9070" FontSize="11" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <!-- Tools -->
                    <Border Background="{DynamicResource ThemeBorder}" Height="1" Margin="0,11,0,9"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#7a9070" FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="Viewers: !request &lt;game&gt; adds to Dormant, !ghhelp shows all commands. Overlay, sound alerts, points &amp; theme are in Settings (⚙)."/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="&#128101; Chatters" Click="Chatters_Click"
                                    Style="{StaticResource ConnectBtn}" Margin="8,0,0,0"
                                    ToolTip="Who's in the room: green = active, yellow = lurking"/>
                            <Button Content="&#128202; Stats" Click="Stats_Click"
                                    Style="{StaticResource ConnectBtn}" Margin="6,0,0,0"
                                    ToolTip="This stream's numbers: messages, top chatters, redeems — with a copyable recap"/>
                            <Button Content="&#128499; Poll" Click="Poll_Click"
                                    Style="{StaticResource ConnectBtn}" Margin="6,0,0,0"
                                    ToolTip="Run a chat poll — viewers vote with !vote 1/2/3, results live on the overlay"/>
                            <Button x:Name="RaidBtn" Content="&#9876; Raid" Click="Raid_Click"
                                    Style="{StaticResource ConnectBtn}" Margin="6,0,0,0"
                                    ToolTip="Spawn a Tavern Tales raid with a 5-minute join timer — viewers join with 'tt raid join'"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Chatter count bar -->
            <Border x:Name="CountBar" Grid.Row="2" Background="{DynamicResource ThemeSurface}"
                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="10,4"
                    Visibility="Collapsed">
                <TextBlock x:Name="CountText" FontSize="12" Foreground="#a8c488"/>
            </Border>

            <!-- Messages -->
            <ScrollViewer x:Name="MsgScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="10,8">
                <ItemsControl x:Name="MessageList">
                    <ItemsControl.Resources>
                        <DataTemplate x:Key="LogRow">
                            <Border Margin="0,1" Padding="4,2" CornerRadius="4" Background="{Binding RowBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11"
                                            Background="{Binding AvatarBrush}" VerticalAlignment="Top" Margin="0,0,7,0">
                                        <TextBlock Text="{Binding Initial}" Foreground="{DynamicResource ThemeBg}" FontSize="11"
                                                   FontWeight="Bold" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="13"
                                               VerticalAlignment="Center" local:ChatInlines.Row="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                        <DataTemplate x:Key="BoxRow">
                            <Border Margin="0,3" CornerRadius="8" Background="{Binding BoxBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="7,3,7,2">
                                        <Border Width="18" Height="18" CornerRadius="9"
                                                Background="{Binding AvatarBrush}" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Initial}" Foreground="{DynamicResource ThemeBg}" FontSize="9"
                                                       FontWeight="Bold" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock FontSize="12" VerticalAlignment="Center"
                                                   local:ChatInlines.HeaderRow="{Binding}"/>
                                    </StackPanel>
                                    <Border Background="#DD000000" CornerRadius="0,0,8,8" Padding="9,4">
                                        <TextBlock TextWrapping="Wrap" FontSize="13"
                                                   local:ChatInlines.BodyRow="{Binding}"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.Resources>
                </ItemsControl>
            </ScrollViewer>

            <!-- Send bar (two-way chat via Social Stream Ninja) -->
            <Border Grid.Row="4" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}"
                    BorderThickness="0,1,0,0" Padding="8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SendBox" Grid.Column="0" Style="{StaticResource ChanBox}"
                             KeyDown="SendBox_KeyDown" Margin="0,0,6,0"
                             ToolTip="Send a message to your chats through Social Stream Ninja (needs SSN connected)"/>
                    <ComboBox x:Name="SendTargetCombo" Grid.Column="1" MinWidth="92" Margin="0,0,6,0"
                              VerticalAlignment="Center" SelectionChanged="SendTarget_Changed"
                              ToolTip="Where to send: all connected chats, or just one platform"/>
                    <Button x:Name="SendBtn" Grid.Column="2" Content="Send" Click="Send_Click"
                            Style="{StaticResource ConnectBtn}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
