<Window x:Class="GameTracker.Views.UpdatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Updating"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False"
        Background="{DynamicResource ScaleBrush}">
    <Border BorderBrush="#FFFFFF" BorderThickness="3" Padding="2">
    <Border BorderBrush="#8090E8" BorderThickness="1">
        <StackPanel Margin="22,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Image Source="/tt-chat.ico" Width="24" Height="24" Margin="0,0,10,0"
                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Updating Tequilas' Tavern"
                           Foreground="#ffffff" FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <ProgressBar x:Name="Bar" Height="10" Minimum="0" Maximum="100"
                         Background="{DynamicResource ThemeSurface}" Foreground="{DynamicResource ThemeAccent}"
                         BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"/>

            <TextBlock x:Name="StatusText" Text="Starting…"
                       Foreground="#dbe4ff" FontSize="12" Margin="0,8,0,0"/>
            <TextBlock Text="The app will reopen automatically when it's done."
                       Foreground="#6f7cb5" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>
    </Border>
    </Border>
</Window>
