<Window x:Class="GameTracker.Views.QuickNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Clip Note"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False"
        Background="{DynamicResource ScaleBrush}">
    <Border BorderBrush="#FFFFFF" BorderThickness="3" Padding="2">
    <Border BorderBrush="#8090E8" BorderThickness="1">
        <StackPanel Margin="16">
            <TextBlock Text="&#128204; QUICK CLIP NOTE" Foreground="{DynamicResource ThemeAccent2}"
                       FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBox x:Name="NoteInput" KeyDown="NoteInput_KeyDown"
                     Background="{DynamicResource ThemeSurface}" Foreground="#ffffff" BorderBrush="{DynamicResource ThemeBorder}"
                     BorderThickness="1" CaretBrush="{DynamicResource ThemeAccent}" Padding="8,7" FontSize="14"
                     VerticalContentAlignment="Center"/>
            <TextBlock Text="Enter to save · Esc to cancel" Foreground="#4a5798"
                       FontSize="11" Margin="2,6,0,0"/>
        </StackPanel>
    </Border>
    </Border>
</Window>
