<Window x:Class="GameTracker.Views.VoiceLabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Voice Lab"
        Width="560" Height="580"
        MinWidth="480" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize"
        Icon="/iguana-eye.ico"
        Background="{DynamicResource ScaleBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#a8c488"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="80"/>
        </Style>
        <Style x:Key="In" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
            <Setter Property="Foreground" Value="#e8e0c4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface2}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource ThemeAccentDeep}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeAccentDeep}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource ThemeAccentDeep}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource ThemeBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Image Source="/iguana-eye.ico" Width="16" Height="16" Margin="0,0,8,0"
                               VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="VOICE LAB" Foreground="{DynamicResource ThemeAccent}" FontSize="11"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="&#x2715;" Click="Close_Click"
                            Style="{StaticResource WindowCloseButton}" Height="32"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <!-- Builder -->
            <StackPanel Grid.Row="1" Margin="16,12,16,6">
                <TextBlock Foreground="#7a9070" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="Build a voice: pick a base voice + effect, type a phrase, and Test. Give it a name and Save to add it to your voice list (and the per-chatter pool)."/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Base voice" Style="{StaticResource Lbl}"/>
                    <ComboBox x:Name="VoiceBox" Width="180" Margin="0,0,10,0"/>
                    <TextBlock Text="Effect" Style="{StaticResource Lbl}" Width="46"/>
                    <ComboBox x:Name="EffectBox" Width="130" DisplayMemberPath="Label"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Phrase" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="PhraseBox" Width="320" Style="{StaticResource In}"
                             Text="Well well well, look who it is."/>
                    <Button Content="&#9654; Test" Click="Test_Click" Style="{StaticResource Btn}" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Name" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="NameBox" Width="180" Style="{StaticResource In}"
                             ToolTip="A name for this custom voice"/>
                    <Button Content="&#128190; Save voice" Click="Save_Click" Style="{StaticResource Btn}" Margin="10,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="Status" Foreground="{DynamicResource ThemeAccent}" FontSize="11" Height="14" Margin="80,4,0,0"/>
            </StackPanel>

            <!-- Saved custom voices (the "soundboard") -->
            <Border Grid.Row="2" Margin="16,4,16,14" Background="{DynamicResource ThemeSurface}"
                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="YOUR CUSTOM VOICES" Foreground="{DynamicResource ThemeAccent}"
                               FontSize="11" FontWeight="Bold" Margin="10,8,10,4"/>
                    <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Foreground="#506050" FontSize="11"
                               Margin="10,0,10,0" Text="None yet — build one above and Save."/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,4,10,10">
                        <ItemsControl x:Name="CustomList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ThemeSurface2}" BorderBrush="{DynamicResource ThemeBorder}"
                                            BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="#e8e0c4" FontSize="13" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Detail}" Foreground="#7a9070" FontSize="11"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="&#9654; Play" Tag="{Binding}" Click="Play_Click"
                                                    Style="{StaticResource Btn}" Margin="0,0,6,0"/>
                                            <Button Grid.Column="2" Content="&#x2715;" Tag="{Binding}" Click="Delete_Click"
                                                    Style="{StaticResource Btn}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
